  "semanticTokenColors": {
    "namespace": "#8be9fd",
    "class": "#8be9fd",
    "struct": "#8be9fd",
    "interface": "#8be9fd",
    "enum": "#8be9fd",
    "type": "#8be9fd",
    "typeParameter": {
      "foreground": "#8be9fd",
      "fontStyle": "italic"
    },
    "function": "#61afef",
    "method": "#61afef",
    "macro": "#56b6c2",
    "decorator": "#56b6c2",
    "property": "#e06c75",
    "enumMember": "#bd93f9",
    "variable.readonly": "#bd93f9",
    "variable.defaultLibrary": "#e06c75",
    "parameter": {
      "foreground": "#ffb86c",
      "fontStyle": "italic"
    },
    "selfParameter": {
      "foreground": "#ff79c6",
      "fontStyle": "italic"
    },
    "*.deprecated": {
      "fontStyle": "strikethrough"
    }
  },
  "tokenColors": [
    {
      "name": "Default text",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#f1fa8c"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6b7694",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comments",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "#7a86a8"
      }
    },
    {
      "name": "Keywords & storage",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#ff79c6"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#56b6c2"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.block",
        "punctuation.terminator",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#8a92a3"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#98c379"
      }
    },
    {
      "name": "Template expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#ff79c6"
      }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#56b6c2"
      }
    },
    {
      "name": "Numbers & constants",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#bd93f9"
      }
    },
    {
      "name": "Null / undefined",
      "scope": [
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.nil"
      ],
      "settings": {
        "foreground": "#bd93f9",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#61afef"
      }
    },
    {
      "name": "Types & classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#8be9fd"
      }
    },
    {
      "name": "Built-in types",
      "scope": [
        "support.type.primitive",
        "storage.type.primitive",
        "keyword.type"
      ],
      "settings": {
        "foreground": "#56b6c2"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#f1fa8c"
      }
    },
    {
      "name": "this / self",
      "scope": [
        "variable.language",
        "variable.parameter.function.language.special.self"
      ],
      "settings": {
        "foreground": "#ff79c6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#ffb86c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#e06c75"
      }
    },
    {
      "name": "Decorators & annotations",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation",
        "meta.annotation"
      ],
      "settings": {
        "foreground": "#56b6c2"
      }
    },
    {
      "name": "Imports / modules",
      "scope": [
        "support.module",
        "entity.name.module",
        "meta.import variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#8be9fd"
      }
    },
    {
      "name": "HTML / JSX tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#e06c75"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#d19a66",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css",
        "meta.selector"
      ],
      "settings": {
        "foreground": "#8be9fd"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#ffb86c"
      }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value.css",
        "constant.numeric.css",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#bd93f9"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "source.json support.type.property-name"
      ],
      "settings": {
        "foreground": "#61afef"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#ff79c6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#ffb86c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#f1fa8c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#50fa7b"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#8be9fd"
      }
    },
    {
      "name": "Markdown quotes & lists",
      "scope": [
        "markup.quote",
        "markup.list punctuation.definition.list.begin"
      ],
      "settings": {
        "foreground": "#bd93f9"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#98c379"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#e06c75"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#61afef"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff5555"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#d19a66",
        "fontStyle": "strikethrough"
      }
    }
  ]
}
